# Banco de Dados PostgreSQL
DATABASE_URL="postgresql://user:password@host:port/database"

# JWT Secrets (use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET="<GERAR_SECRET_64_CARACTERES>"
JWT_REFRESH_SECRET="<GERAR_SECRET_64_CARACTERES>"

# Servidor
PORT=3001
NODE_ENV=development
